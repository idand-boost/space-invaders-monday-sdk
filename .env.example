# Copy this file to .env and fill in both values. Never commit .env.
# Your personal monday API token (Developer Center > API token). Keep it secret.
# No VITE_ prefix on purpose: Vite sends anything starting with VITE_ to the browser.
MONDAY_API_TOKEN=

# Not a secret: the number in your board URL after /boards/.
VITE_MONDAY_BOARD_ID=
